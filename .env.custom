# Use this .env file when using custom Docker image with PySpark pre-installed
# To use: rename this to .env (backup your current .env first)

# Comment out AIRFLOW_IMAGE_NAME to use the custom built image
# AIRFLOW_IMAGE_NAME=apache/airflow:3.1.2
AIRFLOW_UID=50000

# No need for _PIP_ADDITIONAL_REQUIREMENTS when using custom image
_PIP_ADDITIONAL_REQUIREMENTS=
